# SPDX-License-Identifier: MPL-2.0
#
# rsr-profile.a2ml — this repo's declared RSR v2.0 capabilities.
# Generated by just repo-init on 2026-09-26. The template's maximal
# profile was removed at mint: declare only what this tree carries.

[rsr-profile]
version = "1.0.0"
spec = "rsr-criteria-v2"
declares-against = "2.0.0-draft"
# Declared against standards .machine_readable/template-capability-gates.toml.
# Only capabilities grounded in files that exist in this tree.
capabilities = [
  "rust",               # src/ingest, src/store, src/transcribe (Cargo crates)
  "haskell",            # src/parse (dicta-task-parse, cabal)
  "zig",                # src/interface/ffi/build.zig
  "idris2",             # src/interface/abi.ipkg + src/interface/Abi/
  "bash",               # scripts/*.sh
  "cli",                # dicta-task-ingest binary
  "ffi",                # src/interface/ffi/
  "abi",                # src/interface/Abi/ (Task.idr schema proofs)
  "container",          # build/container/
  "reproducible-build", # build/guix.scm
]
