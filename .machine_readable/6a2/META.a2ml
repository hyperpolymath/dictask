#
# META.a2ml — Architecture decisions, design rationale, governance for dictask

[metadata]
version = "0.1.0"
last-updated = "2026-03-13"

[project-info]
type = "service"  # library | binary | monorepo | service | website
languages = ["rust", "haskell", "idris2", "zig", "bash"]
license = "MPL-2.0"
author = "Jonathan D.A. Jewell (hyperpolymath)"

[architecture-decisions]
decisions = [
  { id = "ADR-001", title = "Haskell for NLP/task parsing", status = "accepted", date = "2026-03-13",
    rationale = "megaparsec/parsec are battle-tested for complex grammars; strong static typing catches edge cases; pure functions are easier to test and make pipeline idempotent" },
  { id = "ADR-002", title = "SQLite as canonical task store", status = "accepted", date = "2026-03-13",
    rationale = "Local-first, zero-config, auditable, single-file backup; WAL mode for concurrent reads; JSON1 extension for structured fields" },
  { id = "ADR-003", title = "Rust for ingest/transcription/store", status = "accepted", date = "2026-03-13",
    rationale = "Performance-critical audio processing; whisper-rs and vosk crate bindings; memory safety without GC" },
  { id = "ADR-004", title = "Idris2 for ABI (task schema proofs)", status = "accepted", date = "2026-03-13",
    rationale = "Dependent types prove task schema correctness at compile-time; formal verification of deduplication logic and confidence thresholds" },
  { id = "ADR-005", title = "Batch processing over real-time", status = "accepted", date = "2026-03-13",
    rationale = "Single-user, recorder-based workflow; batch is simpler, more reliable, and sufficient" },
  { id = "ADR-006", title = "Idempotent pipeline stages", status = "accepted", date = "2026-03-13",
    rationale = "Reprocessing same input must produce same output; enables replay, debugging, and failure recovery" },
  { id = "ADR-007", title = "Confidence-gated automation", status = "accepted", date = "2026-03-13",
    rationale = "High-confidence intents auto-apply; low-confidence goes to review queue; prevents false positives from corrupting task list" },
  { id = "ADR-008", title = "No Python — Rust/Haskell/Julia only", status = "accepted", date = "2026-03-13",
    rationale = "Per hyperpolymath language policy; Python is banned; Julia for batch scripts/data processing if needed" },
]

[development-practices]
build-tool = "just"
container-runtime = "podman"
ci-platform = "github-actions"
package-manager = "cabal"  # for Haskell; cargo for Rust

[goals]
goals = [
  "Automate speech notes into structured, prioritised tasks",
  "Ensure full auditability (audio hash → transcript → parse → task)",
  "Privacy-first: local processing, encrypted cloud backup",
  "Support local-first operation with optional cloud sync",
  "Idempotent, replayable pipeline stages",
]

[non-goals]
non-goals = [
  "Real-time processing (batch is fine)",
  "Multi-user collaboration (single-user focus)",
  "Integration with proprietary task managers (export views instead)",
  "Mobile app (desktop/server pipeline only)",
]

[success-metrics]
metrics = [
  "% of tasks auto-processed vs. requiring manual review",
  "False positive/negative rates for intent detection",
  "Time saved vs. manual note-taking and task entry",
  "Pipeline end-to-end latency (acceptable: < 5 minutes per recording)",
]

[failure-modes]
failures = [
  { mode = "Failed cloud upload", handling = "Retry 3x, then quarantine locally" },
  { mode = "Partial transcription", handling = "Flag for review, log incomplete segments" },
  { mode = "Corrupted audio file", handling = "Skip, log, alert user" },
  { mode = "Low-confidence parse", handling = "Route to review queue, never auto-apply" },
  { mode = "Duplicate detection false positive", handling = "Review queue with both candidates shown" },
]

[privacy]
raw-audio = "Encrypted at rest, retained 30 days locally, cloud backup encrypted"
transcripts = "Stored locally only, redacted if sensitive content detected"
cloud-backups = "Encrypted, minimal retention (configurable)"
secrets = "Managed via rokur (Stapeln secrets tool), never in code/repo"

[maintenance-axes]
scoping-first = true
execution-order = "axis-1 > axis-2 > axis-3"
axis-1 = "must > intend > like"
axis-2 = "corrective > adaptive > perfective"
axis-3 = "systems > compliance > effects"

[scoping]
sources = "README, roadmap, status docs, maintenance checklist, CI/security docs"
marker-scan = "TODO/FIXME/XXX/HACK/STUB/PARTIAL"
idris-unsound-scan = "believe_me/assert_total"

[axis-2-maintenance-rules]
corrective-first = true
adaptive-second = true
adaptive-focus = "scope-change reconciliation, stale-reference removal, obsolete-work culling"
perfective-third = true
perfective-source = "axis-1 honest state after corrective/adaptive updates"

[axis-3-audit-rules]
audit-focus = "systems in place, documentation explains actual state, safety/security accounted for, observed effects reviewed"
compliance-focus = "seams/compromises/exception register, bounded exceptions, anti-drift checks"
drift-risk-example = "single exception broadening into policy violation (e.g. AffineScript->TypeScript spread)"
effects-evidence = "benchmark execution/results and maintainer status dialogue/review"

[design-rationale]
# The pipeline is designed as a series of independent, idempotent stages.
# Each stage reads from the previous stage's output and writes to its own output.
# This enables:
# - Replay: Re-run any stage with the same input to get the same output
# - Debugging: Inspect intermediate artifacts at any stage
# - Recovery: Resume from the last successful stage after failure
# - Testing: Test each stage in isolation with synthetic inputs
