# STATE.a2ml — Project state checkpoint for dicta-task (formerly dictask)

[metadata]
project = "dicta-task"
version = "0.1.0"
last-updated = "2026-09-26"
# AUTHORITY: when this and CLADE [status] phase disagree, CLADE phase is the
# authoritative SCM checkpoint (standards#726).
status = "active"  # active | paused | archived | planned

[project-context]
name = "dicta-task"
purpose = "Speech-to-do pipeline: automate ingestion of speech notes from a portable recorder into a structured, prioritised, auditable task list with local-first storage and optional cloud sync."
completion-percentage = 15

[position]
phase = "implementation"   # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase 0: Architecture & schema design", completion = 90 },
  { name = "Phase 0b: Rename dictask -> dicta-task, re-base on rsr-template-repo", completion = 100 },
  { name = "Phase 1: Canonical task store (SQLite schema + Idris2 ABI proofs)", completion = 30 },
  { name = "Phase 2: Ingest pipeline (udev → archive → cloud backup)", completion = 20 },
  { name = "Phase 3: Transcription engine (Rust + Whisper/Vosk)", completion = 5 },
  { name = "Phase 4: Haskell NLP parser (megaparsec task extraction)", completion = 40 },
  { name = "Phase 5: Confidence scoring & ambiguity handling", completion = 30 },
  { name = "Phase 6: Deduplication engine (exact + semantic matching)", completion = 20 },
  { name = "Phase 7: Review queue & notification system", completion = 0 },
  { name = "Phase 8: View generation (Markdown, JSON, CSV)", completion = 30 },
  { name = "Phase 9: Ansible/Terraform deployment", completion = 10 },
  { name = "Phase 10: Privacy & audit trail hardening", completion = 0 },
]

[blockers-and-issues]
# 1. No Cargo workspace yet: the three crates build independently.
# 2. Root Justfile recipes are template phases; not yet wired to cargo/cabal.
# 3. Storage abstraction (TaskStore trait) not yet extracted — see ADR-0004.

[critical-next-actions]
actions = [
  "Wire just build/test to cargo (src/*) and cabal (src/parse); get CI green",
  "Extract a TaskStore trait in src/store with the SQLite implementation (ADR-0004)",
  "Integrate whisper-rs in src/transcribe",
  "Connect parser output (candidate-intent.json) to the store",
  "Create src/review crate: review queue + notification",
]

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["hyperpolymath tooling", "ambientops"]
depends-on = ["whisper-rs", "vosk", "megaparsec", "sqlite", "stapeln"]
