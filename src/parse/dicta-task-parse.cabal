-- SPDX-License-Identifier: MPL-2.0
cabal-version:      3.0
name:               dicta-task-parse
version:            0.1.0.0
synopsis:           NLP task extraction from speech transcripts
description:
  Haskell parser using megaparsec to extract structured task intents
  from speech transcripts. Produces candidate intents with confidence
  scores for the dicta-task pipeline.
license:            LicenseRef-MPL-2.0
license-file:       ../../LICENSE
author:             Jonathan D.A. Jewell
maintainer:         j.d.a.jewell@open.ac.uk
category:           NLP, Text
build-type:         Simple

library
  exposed-modules:
    DictaTask.Parse.Intent
    DictaTask.Parse.Types
    DictaTask.Parse.Confidence
    DictaTask.Parse.DateResolver
    DictaTask.Parse.Priority
    DictaTask.Parse.Dedup
  other-modules:
    DictaTask.Parse.Internal.Patterns
    DictaTask.Parse.Internal.Tokeniser
  build-depends:
      base        >= 4.17 && < 5
    , megaparsec   >= 9.0
    , text         >= 2.0
    , aeson        >= 2.0
    , uuid         >= 1.3
    , time         >= 1.12
    , containers   >= 0.6
    , vector       >= 0.13
    , bytestring   >= 0.11
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -Wall -Wcompat -Widentities -Wincomplete-record-updates
                    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

test-suite dicta-task-parse-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:
    Test.DictaTask.Parse.IntentSpec
    Test.DictaTask.Parse.ConfidenceSpec
    Test.DictaTask.Parse.DateResolverSpec
    Test.DictaTask.Parse.DedupSpec
  build-depends:
      base
    , dicta-task-parse
    , hspec         >= 2.11
    , QuickCheck    >= 2.14
    , megaparsec
    , text
    , time
  hs-source-dirs:   test
  default-language: GHC2021
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
